{
    "config_version": 2,
    "solver": {
        "print_grid_stats": 1,
        "algorithm": "AGGREGATION",
        "solver": "AMG",
        "smoother": {
            "solver": "CHEBYSHEV",
            "preconditioner": {
                "solver": "BLOCK_JACOBI",
                "max_iters": 1
            },
            "chebyshev_polynomial_order": 2,
            "chebyshev_lambda_estimate_mode": 4,
            "chebyshev_lmin_denom": 10.0,
            "scope": "cheby"
        },
        "presweeps": 1,
        "postsweeps": 1,
        "selector": "MIS",
        "mis_k": 2,
        "aggressive_levels": 1,
        "merge_singletons": 1,
        "convergence": "RELATIVE_INI",
        "coarse_solver": "DENSE_LU_SOLVER",
        "max_iters": 200,
        "monitor_residual": 1,
        "print_solve_stats": 1,
        "min_coarse_rows": 2,
        "max_levels": 2,
        "tolerance": 1e-05,
        "norm": "L2",
        "cycle": "V"
    }
}
